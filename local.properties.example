# Popcoon 環境設定テンプレート
# このファイルを `local.properties` にコピーして値を設定する。
# local.properties は .gitignore 対象のため commit されない。

# ── Android SDK (Android Studio が自動設定) ──────────────────────────────────
sdk.dir=/path/to/Android/Sdk

# ── Amazon Product Advertising API 5.0 (⚠️ 2026-05-15 廃止済み) ───────────────
# PA-API 5.0 は停止済み。後継は Creators API (OAuth2 ベアラ認証、成果要件 10件/30日)。
# 下記の SigV4 用キーは現行 AmazonPaApiClient では常時失敗する — Creators API への
# 移行が必要 (未実施)。移行までは Amazon の実データは FallbackScraper (JSON-LD) が担う。
# 旧キー取得元: https://affiliate.amazon.co.jp/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# ── 楽天 Ichiba API ──────────────────────────────────────────────────────────
# https://webservice.rakuten.co.jp/ で取得
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=

# ── Yahoo! ショッピング API v3 ──────────────────────────────────────────────
# https://e.developer.yahoo.co.jp/ で取得
YAHOO_APP_ID=
YAHOO_SID=

# ── Backend URL ──────────────────────────────────────────────────────────────
# Cloudflare Workers のデプロイ先 URL
BACKEND_URL=https://popcoon-backend.workers.dev

# ── Anthropic API キーはここに置かない ──────────────────────────────────────
# AI アドバイザーの Claude 呼び出しはバックエンド (backend/src/index.ts の
# POST /v1/advice) がプロキシする。鍵は `wrangler secret put ANTHROPIC_API_KEY`
# で Workers 側にのみ設定する (APK に埋め込むと抽出可能なため)。

# ── Release Signing (CI/CD で使用) ───────────────────────────────────────────
# KEYSTORE_PATH=/path/to/release.jks
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
